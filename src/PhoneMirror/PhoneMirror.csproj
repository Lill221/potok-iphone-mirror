<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhoneMirror</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.2</Version>
    <Authors>Lill221</Authors>
    <Product>Potok — iPhone screen mirroring</Product>
    <Description>Windows interface for local iPhone mirroring over USB networking and Wi-Fi.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
